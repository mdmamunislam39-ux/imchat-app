# Server Port
PORT=3000

# PostgreSQL Configuration
PG_HOST=localhost
PG_PORT=5432
PG_DATABASE=imchat_db
PG_USER=postgres
PG_PASSWORD=your_secure_password

# LiveKit WebRTC Configuration (if using VPS LiveKit)
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=your_livekit_secret_key

# Firebase Service Account JSON (paste one-line JSON string or path)
# Get this from Firebase Console -> Project Settings -> Service Accounts -> Generate New Private Key
FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"your_project_id",...}
