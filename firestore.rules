rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Function to check if user is admin or superAdmin
    function isAdmin() {
      return (exists(/databases/$(database)/documents/Users/$(request.auth.uid)) && 
              get(/databases/$(database)/documents/Users/$(request.auth.uid)).data.role in ['admin', 'superAdmin'] &&
              (!('roleActive' in get(/databases/$(database)/documents/Users/$(request.auth.uid)).data) || get(/databases/$(database)/documents/Users/$(request.auth.uid)).data.roleActive == true)) ||
             (exists(/databases/$(database)/documents/user_roles/$(request.auth.uid)) && 
              get(/databases/$(database)/documents/user_roles/$(request.auth.uid)).data.role in ['admin', 'superAdmin'] &&
              (!('roleActive' in get(/databases/$(database)/documents/user_roles/$(request.auth.uid)).data) || get(/databases/$(database)/documents/user_roles/$(request.auth.uid)).data.roleActive == true));
    }
    
    // Function to check if user is BD
    function isBD() {
      return (exists(/databases/$(database)/documents/Users/$(request.auth.uid)) && 
              get(/databases/$(database)/documents/Users/$(request.auth.uid)).data.role == 'bd' &&
              (!('roleActive' in get(/databases/$(database)/documents/Users/$(request.auth.uid)).data) || get(/databases/$(database)/documents/Users/$(request.auth.uid)).data.roleActive == true)) ||
             (exists(/databases/$(database)/documents/user_roles/$(request.auth.uid)) && 
              get(/databases/$(database)/documents/user_roles/$(request.auth.uid)).data.role == 'bd' &&
              (!('roleActive' in get(/databases/$(database)/documents/user_roles/$(request.auth.uid)).data) || get(/databases/$(database)/documents/user_roles/$(request.auth.uid)).data.roleActive == true));
    }

    // user_roles collection
    match /user_roles/{userId} {
      // Anyone can read roles to determine permissions
      allow read: if true;
      // Only admins can write roles
      allow write: if isAdmin();
    }

    // games collection
    match /games/{gameId} {
      // Anyone can read active games
      allow read: if true;
      // Only admins can create/update/delete games
      allow write: if isAdmin();
    }

    // premium_room_ids collection
    match /premium_room_ids/{originalId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    
    // other collections ... (fallback rule, assume public read for app function, authenticated write)
    match /{document=**} {
      allow read, write: if request.auth != null;
    }
  }
}
